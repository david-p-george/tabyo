{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    // Node 24 executes .ts directly (type stripping); .ts extensions are required in imports.
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
